# Copy to .env.local. Validated at boot by lib/env.ts; a missing or invalid value fails
# `next dev` and `next build` with the variable's name.

# mock: the frontend talks to the MSW mock API (F4) that implements the frozen contract.
# live: the frontend talks to the real Route Handlers (B5 onward).
NEXT_PUBLIC_API_MODE=mock

# Base path of the API. Same in both modes: MSW intercepts it in mock mode.
NEXT_PUBLIC_API_BASE_URL=/api/v1
