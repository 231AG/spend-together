{
  "name": "spendtogether",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:domain": "pnpm --filter @spendtogether/domain test",
    "lint:rules": "node scripts/verify-lint-rules.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.8",
    "turbo": "2.10.13",
    "typescript": "6.0.3",
    "@spendtogether/config": "workspace:*",
    "eslint": "10.10.0"
  }
}
