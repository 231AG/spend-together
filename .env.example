# API mode switch (ADR-002). `mock` runs against the MSW backend (F4),
# `live` against the real API (B5). Both modes must always build.
NEXT_PUBLIC_API_MODE=mock

# Base path for API requests.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Backend variables arrive in phase B0. The service-role key is server-only and
# must NEVER carry a NEXT_PUBLIC_ prefix (spec 8.5, 24.3).
